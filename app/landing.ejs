<div id="landingContainer" style="display: none;">
    <!-- Header: brand, sections and account. -->
    <div id="upper">
        <div id="sc2Brand">
            <div id="image_seal_container">
                <img id="image_seal" src="assets/images/SealCircle.png" alt=""/>
                <div id="updateAvailableTooltip"><%- lang('landing.updateAvailableTooltip') %></div>
            </div>
            <div id="sc2BrandText">
                <span id="sc2BrandKicker"><%- lang('landing.sc2.brandKicker') %></span>
                <span id="sc2BrandName"><%- lang('landing.sc2.brandName') %></span>
            </div>
        </div>
        <nav id="sc2Nav" aria-label="<%- lang('landing.sc2.navLabel') %>">
            <button class="sc2Tab" id="sc2TabJugar" type="button" aria-current="page"><%- lang('landing.sc2.tabJugar') %></button>
            <button class="sc2Tab" id="newsButton" type="button">
                <span id="newsButtonText"><%- lang('landing.sc2.tabNovedades') %></span>
                <span id="newsButtonAlert" style="display: none;"></span>
            </button>
            <button class="sc2Tab" id="settingsMediaButton" type="button"><%- lang('landing.sc2.tabAjustes') %></button>
        </nav>
        <div id="user_content" role="button" tabindex="0">
            <div id="avatarContainer">
                <button id="avatarOverlay" type="button" aria-label="<%- lang('landing.usernameEditButton') %>"></button>
            </div>
            <div id="user_meta">
                <span id="user_text"><%- lang('landing.usernamePlaceholder') %></span>
                <span id="user_role"><%- lang('landing.sc2.manageAccount') %></span>
            </div>
        </div>
    </div>

    <!-- Body: launch column on the left, cards on the right. -->
    <div id="lower">
        <div id="left">
            <span id="sc2Kicker"><%- lang('landing.sc2.kicker') %></span>
            <h1 id="sc2Hero"><%- lang('landing.sc2.heroLine1') %><br><%- lang('landing.sc2.heroLine2') %></h1>
            <p id="sc2Sub"><%- lang('landing.sc2.sub') %></p>
            <div id="sc2Panel" class="sc2Frame">
                <div id="server_status_wrapper">
                    <span id="landingPlayerLabel"><%- lang('landing.serverStatus') %></span>
                    <span id="player_count"><%- lang('landing.serverStatusPlaceholder') %></span>
                </div>
                <div class="sc2Rule"></div>
                <div id="sc2Profile">
                    <div id="sc2ProfileText">
                        <button id="server_selection_button" type="button"><%- lang('landing.launchButtonPlaceholder') %></button>
                        <span id="profile_hint"></span>
                    </div>
                    <button id="sc2ProfileChange" class="sc2Btn sc2BtnSecondary" type="button"><%- lang('landing.sc2.change') %></button>
                </div>
                <div id="launch_content">
                    <button id="launch_button" type="button" aria-label="<%- lang('landing.launchButton') %>"></button>
                </div>
                <div id="launch_details">
                    <span id="launch_details_text"><%- lang('landing.launchDetails') %></span>
                    <div id="launch_details_right">
                        <progress id="launch_progress" value="0" max="100"></progress>
                        <div id="sc2ProgressTrack" aria-hidden="true"><div id="sc2ProgressFill"></div></div>
                    </div>
                    <div id="sc2ProgressMeta">
                        <span id="launch_progress_label">0%</span>
                        <span id="sc2DlBytes"></span>
                    </div>
                    <span id="sc2DlSpeed"></span>
                </div>
            </div>
            <div id="sc2Tools">
                <button id="sc2Repair" class="sc2Link sc2Tool" type="button"><span class="sc2LinkIcon sc2IconRepair"></span><%- lang('landing.sc2.repair') %></button>
                <button id="sc2Zip" class="sc2Link sc2Tool" type="button"><span class="sc2LinkIcon sc2IconZip"></span><%- lang('landing.sc2.zip') %></button>
            </div>
        </div>
        <div id="center">
            <button id="sc2NewsCard" class="sc2Frame" type="button">
                <span class="sc2CardKicker"><%- lang('landing.sc2.newsKicker') %></span>
                <span class="sc2CardTitle"><%- lang('landing.sc2.newsTitle') %></span>
                <span class="sc2CardSub"><%- lang('landing.sc2.newsSub') %></span>
                <span class="sc2Chevron" aria-hidden="true"></span>
            </button>
        </div>
    </div>

    <!-- Footer: version, site and external links. -->
    <div id="sc2Footer">
        <button id="sc_version_badge" type="button">
            <span id="sc_version_text"></span>
        </button>
        <span id="sc2Site">servidorcobblemon.es</span>
        <div id="sc2Links">
            <a href="<%- lang('landing.sc2.webURL') %>" class="sc2Link" id="sc2Web"><span class="sc2LinkIcon sc2IconWeb"></span><%- lang('landing.sc2.web') %></a>
            <a href="<%- lang('landing.mediaTiendaURL') %>" class="sc2Link" id="tiendaURL"><span class="sc2LinkIcon sc2IconShop"></span><%- lang('landing.mediaTienda') %></a>
            <a href="<%- lang('landing.mediaDiscordURL') %>" class="sc2Link" id="discordURL"><span class="sc2LinkIcon sc2IconDiscord"></span><%- lang('landing.mediaDiscord') %></a>
        </div>
    </div>

    <!-- News view: opens over the body, the header stays. -->
    <div id="newsContainer" aria-hidden="true">
        <div id="sc2NewsFrame" class="sc2Frame">
            <div id="newsContent" article="-1" style="display: none;">
                <div id="newsStatusContainer">
                    <div id="newsStatusContent">
                        <a id="newsArticleTitle" href="#">Lorem Ipsum</a>
                        <div id="newsMetaContainer">
                            <span id="newsArticleDate"></span>
                            <span id="newsArticleAuthor"></span>
                            <a href="#" id="newsArticleComments"></a>
                        </div>
                    </div>
                    <div id="newsNavigationContainer">
                        <button id="newsNavigateLeft" type="button" aria-label="<%- lang('landing.sc2.newsPrev') %>"></button>
                        <span id="newsNavigationStatus"><%- lang('landing.newsNavigationStatus', { currentPage: 1, totalPages: 1 }) %></span>
                        <button id="newsNavigateRight" type="button" aria-label="<%- lang('landing.sc2.newsNext') %>"></button>
                    </div>
                </div>
                <div id="newsArticleContainer">
                    <div id="newsArticleContentScrollable">
                        <!-- Article Content -->
                    </div>
                </div>
            </div>
            <div id="newsErrorContainer">
                <div id="newsErrorLoading">
                    <span id="nELoadSpan" class="newsErrorContent"><%- lang('landing.newsErrorLoadSpan') %></span>
                </div>
                <div id="newsErrorFailed" style="display: none;">
                    <span id="nEFailedSpan" class="newsErrorContent"><%- lang('landing.newsErrorFailedSpan') %></span>
                    <button id="newsErrorRetry" class="sc2Btn sc2BtnSecondary" type="button"><%- lang('landing.newsErrorRetryButton') %></button>
                </div>
                <div id="newsErrorNone" style="display: none;">
                    <span id="nENoneSpan" class="newsErrorContent"><%- lang('landing.newsErrorNoneSpan') %></span>
                </div>
            </div>
        </div>
    </div>
    <script src="./assets/js/scripts/landing.js"></script>
</div>
