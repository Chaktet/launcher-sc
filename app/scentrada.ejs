<!-- Rediseño v5: columna izquierda común de las pantallas de entrada (bienvenida, tipo de
     cuenta, login y espera de Microsoft). Va dentro de cada vista porque se cambian con
     fundidos independientes y la columna tiene que llegar con ellas. -->
<div class="scEntradaIntro">
    <div class="scEntradaMarca">
        <img src="./assets/images/SealCircle.png" alt="">
        <span><small><%- lang('landing.sc2.brandKicker') %></small><b><%- lang('landing.sc2.brandName') %></b></span>
    </div>
    <div class="scEntradaHero">
        <span class="scEntradaKicker"><%- lang('landing.sc2.kicker') %></span>
        <h1><%- lang('scEntrada.hero') %></h1>
        <p><%- lang('scEntrada.texto') %></p>
    </div>
    <span class="scEntradaPie"><%- lang('scEntrada.pie') %></span>
</div>
